# Scripts read environment values first, then 1Password via yeo-key, item
# "Chromescribe Access" (override with CHROMESCRIBE_KEY_ITEM), then this file
# as a last resort. Copy to `.env.chromescribe` (gitignored) and fill in
# the service token. Keep `export` so child processes inherit the values.
export CF_ACCESS_CLIENT_ID="replace-with-service-token-id"
export CF_ACCESS_CLIENT_SECRET="replace-with-service-token-secret"
