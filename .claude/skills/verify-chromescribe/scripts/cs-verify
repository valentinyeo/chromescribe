class UsageError extends Error {}

const out = (value, code = 0) => {
  process.stdout.write(JSON.stringify(value, null, 2) + '\n');
  process.exit(code);
};

const fail = (error, hint, code = 1) => {
  out({ ok: false, error: String(error && error.message ? error.message : error), hint }, code);
};

const npmRoot = execFileSync('npm', ['root', '-g'], { encoding: 'utf8' }).trim();
const WRANGLER = join(npmRoot, 'wrangler', 'bin', 'wrangler.js');

function parseOptions(args, allowed) {
  const options = {};
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (!arg.startsWith('--')) {
      positional.push(arg);
      continue;
    }
    const [flag, inline] = arg.split('=');
    const spec = allowed[flag];
    if (!spec) throw new UsageError(`Unknown option ${flag}. Run cs-verify <command> --help.`);
    if (spec.type === 'boolean') {
      options[flag] = true;
      continue;
    }
    const value = inline ?? args[++i];
    if (value === undefined || value === '') throw new UsageError(`${flag} needs a value`);
    options[flag] = spec.type === 'number' ? Number(value) : value;
    if (spec.type === 'number' && (!Number.isFinite(options[flag]) || options[flag] <= 0)) {
      throw new UsageError(`${flag} must be a positive number, got ${value}`);
    }
  }
  return { options, positional };
}

function requireWrangler() {
  if (!existsSync(WRANGLER)) {
    throw new Error(`Global wrangler not found at ${WRANGLER}. Install it with: npm i -g wrangler`);
  }
}

function playwright() {
  try {
    const require = createRequire(join(npmRoot, 'noop.js'));
    return require('playwright');
  } catch {
    throw new Error(`Global playwright not found under ${npmRoot}. Install it with: npm i -g playwright && npx playwright install chromium`);
  }
}

function readIf(path) {
  return existsSync(path) ? readFileSync(path, 'utf8').trim() : '';
}

function writeLog(path, text) {
  appendFileSync(path, text + '\n');
}

function git(args) {
  return execFileSync('git', ['-C', ROOT, ...args], { encoding: 'utf8' }).trim();
}

function wrangler(args, { logPath, timeout = 240000 } = {}) {
  const result = spawnSync(process.execPath, [WRANGLER, ...args], {
    cwd: DASHBOARD,
    encoding: 'utf8',
    maxBuffer: 128 * 1024 * 1024,
    timeout,
    env: { ...process.env, WRANGLER_SEND_METRICS: 'false' },
  });
  const text = `${result.stdout || ''}${result.stderr || ''}`.trim();
  if (logPath) writeLog(logPath, text);
  if (result.status !== 0) {
    throw new Error(`wrangler ${args.slice(0, 2).join(' ')} failed. ${text.split('\n').slice(-6).join(' ')}`);
  }
  return text;
}

function port(meta) {
  return Number((meta && meta.port) || readIf(join(RUN, 'port')) || DEFAULT_PORT);
}

function readMeta() {
  const text = readIf(join(RUN, 'meta.json'));
  if (!text) return {};
  try {
    return JSON.parse(text);
  } catch {
    return {};
  }
}

function instancePid() {
  const pid = Number(readIf(join(RUN, 'dev.pid')));
  if (!pid) return 0;
  try {
    process.kill(pid, 0);
    return pid;
  } catch {
    return 0;
  }
}

function instanceUrl(meta) {
  return `http://127.0.0.1:${port(meta)}`;
}

async function apiGet(base, path) {
  const response = await fetch(base + path, { signal: AbortSignal.timeout(15000) });
  const text = await response.text();
  let json = null;
  try {
    json = JSON.parse(text);
  } catch {}
  return { status: response.status, text, json };
}

async function waitReady(base, seconds) {
  const deadline = Date.now() + seconds * 1000;
  let last = '';
  while (Date.now() < deadline) {
    try {
      const response = await apiGet(base, '/api/transcripts?limit=1');
      if (response.status === 200 && response.text.includes('"success":true')) return true;
      last = `HTTP ${response.status}`;
    } catch (error) {
      last = error.message;
    }
    await new Promise(done => setTimeout(done, 500));
  }
  throw new Error(`API was not ready after ${seconds}s (${last}). See ${join(RUN, 'dev.log')}`);
}

function portFree(value) {
  const probe = spawnSync(process.execPath, [
    '-e',
    `const s=require('node:net').connect(${value},'127.0.0.1');s.on('connect',()=>{s.destroy();process.exit(0)});s.on('error',()=>process.exit(1))`,
  ], { timeout: 5000 });
  return probe.status !== 0;
}

