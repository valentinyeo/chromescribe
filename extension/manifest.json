{
  "manifest_version": 3,
  "name": "ChromeScribe",
  "version": "1.0.2",
  "description": "One-click send current URL to Claude Code for transcription or summarization",
  "permissions": ["activeTab", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChromeScribe"
  }
}
