#!/usr/bin/env bash

set -euo pipefail

API="${CHROMESCRIBE_API:-https://chromescribe.yeoux.net}"
API="${API%/}"
CLI_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

usage() {
  cat <<EOF
chromescribe - query your transcript knowledge base

Usage:
  chromescribe list [-n N] [--channel <name>] [--json]          List transcripts (newest first)
  chromescribe search <query> [--json]       Search titles/channels/video_id
  chromescribe get <id> [--json]             Show metadata for one transcript
  chromescribe cat <id>                      Print the full markdown to stdout
  chromescribe url <source-url> [--json]     Find transcript by source URL
  chromescribe view <id>                     Print dashboard URL for browser

  chromescribe channels [--json | --refresh] List subscriptions or repair YouTube names
  chromescribe subscribe <url|@handle|UC id> Subscribe to a channel
  chromescribe unsubscribe <channel>        Remove a subscription, keep transcripts
  chromescribe pause <channel>              Pause monitoring
  chromescribe resume <channel>             Resume monitoring
  chromescribe learn <channel> [--max N] [--no-queue]
                                            Subscribe, queue up to 30 newest uploads,
                                            distill all current channel transcripts
  chromescribe lens <channel> "<topic>" [--no-publish]
                                            Generate a cited report, publish to the site
                                            or print a local HTML path

Channel selectors: exact name, @handle, UC ID, or channel URL (case-insensitive).
Learning uses yt-dlp with RSS fallback, hax Codex, and Python 3. Lenses live in
~/projects/channel-lenses/lenses/<handle>, installed as Claude skills.
Run learn again after the queue drains to incorporate new transcripts.

Env:
  CHROMESCRIBE_API           Override API base (default: https://chromescribe.yeoux.net)
  CF_ACCESS_CLIENT_ID        Cloudflare Access service token ID (required: API is gated)
  CF_ACCESS_CLIENT_SECRET    Cloudflare Access service token secret
  CHROMESCRIBE_YEO_KEY       Key reader tried first for "Chromescribe Access" (default: yeo-key, empty: env only)

Examples:
  chromescribe list -n 20
  chromescribe search "karpathy"
  chromescribe cat 42 | glow -
  chromescribe cat 42 > notes.md
  chromescribe learn "Jake Trinder" --no-queue
  chromescribe lens "Jake Trinder" "how to get clients from YouTube" --no-publish
EOF
}

die() { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dep: $1"; }

need curl
need jq

YEO_KEY="${CHROMESCRIBE_YEO_KEY-yeo-key}"
if [ -n "$YEO_KEY" ] && command -v "$YEO_KEY" >/dev/null 2>&1; then
  vault_id="$("$YEO_KEY" "Chromescribe Access" CF_ACCESS_CLIENT_ID 2>/dev/null || true)"
  vault_secret="$("$YEO_KEY" "Chromescribe Access" CF_ACCESS_CLIENT_SECRET 2>/dev/null || true)"
  if [ -n "$vault_id" ] && [ -n "$vault_secret" ]; then
    export CF_ACCESS_CLIENT_ID="$vault_id" CF_ACCESS_CLIENT_SECRET="$vault_secret"
  fi
  unset vault_id vault_secret
fi

CF_ID="${CF_ACCESS_CLIENT_ID:-}"
CF_SECRET="${CF_ACCESS_CLIENT_SECRET:-}"

api_curl() {
  local args=("-fsSL")
  if [ -n "$CF_ID" ] && [ -n "$CF_SECRET" ]; then
    args+=(-H "CF-Access-Client-Id: $CF_ID" -H "CF-Access-Client-Secret: $CF_SECRET")
  fi
  curl "${args[@]}" "$@"
}

api_get() {
  api_curl "$API$1" || die "API request failed: $1 (check CF_ACCESS_CLIENT_ID/SECRET if behind Zero Trust)"
}

unwrap() {
  jq -e 'if .success == false then error("API error: " + (.error // "unknown")) else .data end'
}

fmt_row() {
  jq -r '[.id, (.created_at // "")[0:10], (.channel // "")[0:20], (.duration_formatted // ""), (.word_count|tostring), .title] | @tsv'
}

render_table() {
  local data
  data=$(cat)
  if [ "$(echo "$data" | jq 'length')" = "0" ]; then
    echo "(no results)"
    return
  fi
  {
    printf "ID\tDATE\tCHANNEL\tDUR\tWORDS\tTITLE\n"
    echo "$data" | jq -c '.[]' | while IFS= read -r row; do
      echo "$row" | fmt_row
    done
  } | column -t -s $'\t' -o '  '
}

cmd_list() {
  local limit=50 json=0 channel=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) [ $# -ge 2 ] || die "-n requires a number"; limit="$2"; [[ "$limit" =~ ^[1-9][0-9]*$ ]] || die "invalid limit: $limit"; shift 2;;
      --channel) [ $# -ge 2 ] || die "--channel requires a channel"; channel="$2"; shift 2;;
      --json) json=1; shift;;
      -h|--help) usage; exit 0;;
      *) die "unknown arg: $1";;
    esac
  done
  local data
  local name=""
  if [ -n "$channel" ]; then
    name=$(resolve_channel "$channel" | jq -r .name)
  fi
  data=$(api_get /api/transcripts | unwrap | jq --arg name "$name" --argjson limit "$limit"     '[.[] | select($name == "" or ((.channel // "" | ascii_downcase) == ($name | ascii_downcase)))] | .[:$limit]')
  if [ "$json" = "1" ]; then
    echo "$data"
  else
    echo "$data" | render_table
  fi
}

cmd_search() {
  local json=0 query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift;;
      -h|--help) usage; exit 0;;
      *) query="$1"; shift;;
    esac
  done
  [ -n "$query" ] || die "search requires a query"
  local encoded
  encoded=$(jq -rn --arg q "$query" '$q | @uri')
  local data
  data=$(api_get "/api/search?q=$encoded" | unwrap)
  if [ "$json" = "1" ]; then
    echo "$data"
  else
    echo "$data" | render_table
  fi
}

cmd_get() {
  local json=0 id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift;;
      -h|--help) usage; exit 0;;
      *) id="$1"; shift;;
    esac
  done
  [ -n "$id" ] || die "get requires an id"
  local data
  data=$(api_get "/api/transcripts/$id" | unwrap)
  if [ "$json" = "1" ]; then
    echo "$data"
  else
    echo "$data" | jq -r '
      "ID:       \(.id)",
      "Title:    \(.title)",
      "Channel:  \(.channel)",
      "Video ID: \(.video_id)",
      "Duration: \(.duration) sec",
      "Words:    \(.word_count)",
      "Created:  \(.created_at)",
      "View:     https://chromescribe.yeoux.net/transcript.html?id=\(.id)"
    '
  fi
}

cmd_cat() {
  local id="${1:-}"
  [ -n "$id" ] || die "cat requires an id"
  api_curl "$API/api/transcript/$id/content" || die "failed to fetch content for id=$id"
}

cmd_url() {
  local json=0 src=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift;;
      -h|--help) usage; exit 0;;
      *) src="$1"; shift;;
    esac
  done
  [ -n "$src" ] || die "url requires a source URL"
  local vid
  vid=$(echo "$src" | grep -oE '(youtube\.com/watch\?v=|youtu\.be/|youtube\.com/shorts/)[a-zA-Z0-9_-]{11}' | grep -oE '[a-zA-Z0-9_-]{11}$' || true)
  if [ -z "$vid" ]; then
    local tt
    tt=$(echo "$src" | grep -oE 'tiktok\.com/@[^/]+/video/[0-9]+' | grep -oE '[0-9]+$' || true)
    [ -n "$tt" ] || die "could not parse video id from URL"
    vid="tiktok:$tt"
  fi
  local data
  data=$(api_get /api/transcripts | unwrap | jq --arg v "$vid" '[.[] | select(.video_id == $v)]')
  if [ "$json" = "1" ]; then
    echo "$data"
  else
    echo "$data" | render_table
  fi
}

cmd_view() {
  local id="${1:-}"
  [ -n "$id" ] || die "view requires an id"
  echo "https://chromescribe.yeoux.net/transcript.html?id=$id"
}

api_write() {
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    api_curl -X "$method" -H 'Content-Type: application/json' --data "$body" "$API$path" | unwrap
  else
    api_curl -X "$method" "$API$path" | unwrap
  fi
}

resolve_channel() {
  need python3
  api_get /api/channels | unwrap | python3 "$CLI_DIR/lenses.py" resolve "$1"
}

cmd_channels() {
  [ $# -eq 0 ] || { [ $# -eq 1 ] && { [ "$1" = --json ] || [ "$1" = --refresh ]; }; } || die "usage: channels [--json | --refresh]"
  local data row id hint refreshed failed=0
  data=$(api_get /api/channels | unwrap | jq 'sort_by(.name | ascii_downcase)')
  if [ "${1:-}" = --refresh ]; then
    while IFS= read -r row; do
      id=$(echo "$row" | jq -r '.id | @uri')
      hint=$(curl -s --max-time 15 -H 'Accept-Language: en' -b 'SOCS=CAI' "https://www.youtube.com/channel/$id" |
        grep -oE '"vanityChannelUrl":"https?://(www\.)?youtube\.com/@[^"/]+' | head -1 | sed 's|.*/||') || hint=
      if refreshed=$(api_write POST "/api/channels/$id/refresh" "$(jq -nc --arg h "$hint" 'if $h == "" then {} else {handle: $h} end')"); then
        printf '%s -> %s\n' "$(echo "$row" | jq -r '[.name, .handle] | join(" (") + ")"')" \
          "$(echo "$refreshed" | jq -r '[.name, .handle] | join(" (") + ")"')"
      else
        echo "error: could not refresh $(echo "$row" | jq -r '.id')" >&2
        failed=1
      fi
    done < <(echo "$data" | jq -c '.[] | select(.platform == "youtube") |
      select((.handle | startswith("@") | not) or (.name | test("^UC[A-Za-z0-9_-]{22}$")))')
    return "$failed"
  elif [ "${1:-}" = --json ]; then
    echo "$data"
  else
    echo "$data" | jq -r '.[] | [.name, .handle, .id, (if .paused == 1 or .paused == true then "paused" else "active" end)] | @tsv'
  fi
}

cmd_subscribe() {
  [ $# -eq 1 ] || die "usage: subscribe <url|@handle|UC id>"
  api_write POST /api/channels "$(jq -nc --arg input "$1" '{input:$input}')"
}

cmd_channel_change() {
  local action="$1"; shift
  [ $# -eq 1 ] || die "usage: $action <channel>"
  local id
  id=$(resolve_channel "$1" | jq -r '.id | @uri')
  case "$action" in
    unsubscribe) api_write DELETE "/api/channels/$id";;
    pause) api_write PATCH "/api/channels/$id" '{"paused":true}';;
    resume) api_write PATCH "/api/channels/$id" '{"paused":false}';;
  esac
}

cmd_lenses() {
  need python3
  python3 "$CLI_DIR/lenses.py" "$@"
}

main() {
  local cmd="${1:-}"
  [ -n "$cmd" ] || { usage; exit 1; }
  shift
  case "$cmd" in
    channels) cmd_channels "$@";;
    subscribe) cmd_subscribe "$@";;
    unsubscribe|pause|resume) cmd_channel_change "$cmd" "$@";;
    learn|lens) cmd_lenses "$cmd" "$@";;
    list)   cmd_list   "$@";;
    search) cmd_search "$@";;
    get)    cmd_get    "$@";;
    cat)    cmd_cat    "$@";;
    url)    cmd_url    "$@";;
    view)   cmd_view   "$@";;
    -h|--help|help) usage;;
    *) die "unknown command: $cmd (try --help)";;
  esac
}

main "$@"
